#!/usr/bin/env argsh
# shellcheck shell=bash
# vim: set ft=sh:
set -euo pipefail

import shell-op

# args array is defined by the shell-op library (per binding type)
# we only define variables that we use
# ctx contains the raw json from the binding context
pod::handle() {
  local event name namespace ctx
  :args "Handle pod events" "${@}"

  case "${event}" in
    "Synchronization")
      echo "Pod ${namespace}/${name} was synced"
      ;;
    *)
      echo "Pod ${namespace}/${name} was ${event}"
      ;;
  esac
}

cron::handle() {
  local event binding
  :args "Handle cron events" "${@}"

  echo "Cron ${binding} fired: ${event}"
}

startup::init() {
  echo "Hook startup — initializing..."
}

# can have multiple kinds and events (repeatable -k and -e)
# --no-sync will skip Synchronization on startup
shell-op::on pod::handle -k v1/Pod -e Added -e Modified -e Deleted -f .metadata.name
# shell-op::on pod::handle -k Pod -k Service -e Added  # auto-groups multiple kinds
# shell-op::on pod::handle -k Pod --queue slow --resync 1h

shell-op::cron "*/5 * * * *" cron::handle
# shell-op::cron "0 * * * *" cron::handle --queue slow --allow-failure
# shell-op::cron "*/5 * * * *" cron::handle --include-snapshots pod::handle

# --startup registers a script-level handler for onStartup events
# --order controls execution order across multiple hooks (default: 1)
shell-op::run --startup startup::init "${@}"
