#!/usr/bin/env argsh
# shellcheck shell=bash
# @file shell-op
# @brief Declarative shell-operator hooks with argsh
# @description
#   Wraps flant/shell-operator hook boilerplate into clean argsh functions.
#   Declare bindings, route events to handlers, access context via :args.
#
#   Library:    import shell-op

: "${SHELLOP_BINDINGS:="$(mktemp)"}"

to::declared() {
  declare -f "${1:-}" &>/dev/null || return 1
  echo "${1}"
}

# @description Register a Kubernetes watch binding.
# @example
#   shell-op::on -k v1/Pod -e Added -e Modified -f .metadata.name pod::handle
#   shell-op::on -k Pod -k Service -e Added pod::handle
shell-op::on() {
  local handler labels filter namespace group no_sync=0 path_bindings="${path_bindings:-${SHELLOP_BINDINGS}}"
  local -a kind=() event=() args=(
    'handler:~declared'         "Handler function"
    'kind|k:!'          "Resource kind, with optional apiVersion (v1/Pod, apps/v1/Deployment)"
    'event|e'           "Watch event: Added, Modified, Deleted (repeatable)"
    'labels|l'          "Label selector (key=val,...)"
    'filter|f'          "jq filter expression"
    'namespace|n'       "Namespace to watch"
    'group|g'           "Group key for batching"
    'no-sync:+'         "Skip Synchronization on startup"
    'path_bindings|:^~file' "Path to bindings file"
    "${args[@]}"
  )
  :args "Register a Kubernetes watch binding" "${@}"

  # Auto-group if multiple kinds
  if (( ${#kind[@]} > 1 )) && [[ -z "${group:-}" ]]; then
    group="${handler}"
  fi

  local kind_spec api k
  for kind_spec in "${kind[@]}"; do
    if [[ "${kind_spec}" == */* ]]; then
      api="${kind_spec%/*}"
      k="${kind_spec##*/}"
    else
      api=""
      k="${kind_spec}"
    fi
    k="${k^}"

    local json='{"name":"'"${handler}"'","kind":"'"${k}"'"'
    [[ -z "${api}" ]]           || json+=',"apiVersion":"'"${api}"'"'
    [[ -z "${filter:-}" ]]      || json+=',"jqFilter":"'"${filter}"'"'
    [[ -z "${namespace:-}" ]]   || json+=',"namespace":{"nameSelector":{"matchNames":["'"${namespace}"'"]}}'
    [[ -z "${group:-}" ]]       || json+=',"group":"'"${group}"'"'

    if (( no_sync )); then
      json+=',"executeHookOnSynchronization":false'
    fi

    if (( ${#event[@]} > 0 )); then
      json+=',"executeHookOnEvent":['
      local first=1 ev
      for ev in "${event[@]}"; do
        (( first )) && first=0 || json+=","
        json+='"'"${ev}"'"'
      done
      json+=']'
    fi

    if [[ -n "${labels:-}" ]]; then
      json+=',"labelSelector":{"matchLabels":{'
      local lfirst=1 lbl lk lv
      IFS=',' read -ra lbls <<< "${labels}"
      for lbl in "${lbls[@]}"; do
        lk="${lbl%%=*}"
        lv="${lbl#*=}"
        (( lfirst )) && lfirst=0 || json+=","
        json+='"'"${lk}"'":"'"${lv}"'"'
      done
      json+='}}'
    fi

    json+='}'
    echo "kubernetes"$'\t'"${json}" >> "${path_bindings}"
  done
}

# @description Register a schedule binding.
# @example
#   shell-op::cron "*/5 * * * *" cron::handle
shell-op::cron() {
  local crontab handler path_bindings="${path_bindings:-${SHELLOP_BINDINGS}}"
  local -a args=(
    'crontab:!' "Cron expression (5 or 6 fields)"
    'handler:~declared' "Handler function"
    'path_bindings|:^~file' "Path to bindings file"
    "${args[@]}"
  )
  :args "Register a schedule binding" "${@}"

  local json='{"name":"'"${handler}"'","crontab":"'"${crontab}"'"}'
  echo "schedule"$'\t'"${json}" >> "${path_bindings}"
}

# shellcheck disable=SC2120
# @description Generate --config JSON from registered bindings.
# @stdout JSON config for shell-operator
# @internal
shell-op::config() {
  local startup="${startup:-}" order="${order:-1}" path_bindings="${path_bindings:-${SHELLOP_BINDINGS}}"
  local -a args=(
    'startup|:^' "Startup handler function"
    'order|:^' "Startup execution order"
    'path_bindings|:^~file' "Path to bindings file"
  )
  :args "Generate --config JSON from registered bindings" "${@}"

  local out='{"configVersion":"v1"'

  if [ -n "${startup}" ]; then
    out+=',"onStartup":'"${order}"
  fi

  # Collect entries by type
  local -a k8s=() sched=()

  if [[ -s "${path_bindings}" ]]; then
    local btype bdata
    while IFS=$'\t' read -r btype bdata; do
      case "${btype}" in
        kubernetes) k8s+=("${bdata}") ;;
        schedule)   sched+=("${bdata}") ;;
      esac
    done < "${path_bindings}"
  fi

  local json
  if (( ${#sched[@]} > 0 )); then
    out+=',"schedule":['

    for json in "${sched[@]}"; do
      out+="${json},"
    done
    out="${out:0:-1}]"
  fi

  if (( ${#k8s[@]} > 0 )); then
    out+=',"kubernetes":['
    
    for json in "${k8s[@]}"; do
      out+="${json},"
    done
    out="${out:0:-1}]"
  fi

  out+='}'
  echo "${out}"
}

# @description Dispatch a single binding context entry to the right handler.
# @arg $1 int Context index
# @internal
shell-op::dispatch() {
  local index path_ctx="${path_ctx:-${BINDING_CONTEXT_PATH}}" path_bindings="${path_bindings:-${SHELLOP_BINDINGS}}"
  local -a args=(
    'index:!' 'Context index'
    'path_ctx|:^~file' 'Path to binding context file'
    'path_bindings|:^~file' 'Path to bindings file'
    "${args[@]}"
  )
  :args "Dispatch a single binding context entry to the right handler" "${@}"
    
  local -ra SHELLOP_CRON_ARGS=(
    'event'     "Event (Schedule)"
    'binding'   "Binding name"
    'ctx'       "Raw JSON binding context"
  )

  local -ra SHELLOP_K8S_ARGS=(
    'event'      "Event (Added/Modified/Deleted/Synchronization/Group/onStartup)"
    'kind'       "Resource kind"
    'name'       "Object metadata.name"
    'namespace'  "Object metadata.namespace"
    'type'       "Context type (Event/Synchronization/Group)"
    'binding'    "Binding name"
    'watchEvent' "Watch event (Added/Modified/Deleted)"
    'ctx'        "Raw JSON binding context"
  )

  local ctx type binding watchEvent event
  ctx="$(jq -c ".[${index}]" "${path_ctx}")"
  type="$(jq -r '.type // empty' <<< "${ctx}")"
  binding="$(jq -r '.binding // empty' <<< "${ctx}")"
  watchEvent="$(jq -r '.watchEvent // empty' <<< "${ctx}")"

  # Unified event: watchEvent > type
  event="${watchEvent:-${type}}"

  # Find handler and entry type by binding name
  local _handler="" _entry_type="" _etype _edata
  if [[ -s "${path_bindings}" ]]; then
    while IFS=$'\t' read -r _etype _edata; do
      if [[ "${_edata}" == *"\"name\":\"${binding}\""* ]]; then
        _handler="${binding}"
        _entry_type="${_etype}"
        break
      fi
    done < "${path_bindings}"
  fi

  [[ -n "${_handler}" ]] || {
    return 0
  }

  # Extract object fields
  local name namespace kind
  name="$(jq -r '.object.metadata.name // empty' <<< "${ctx}")"
  namespace="$(jq -r '.object.metadata.namespace // empty' <<< "${ctx}")"
  kind="$(jq -r '.object.kind // empty' <<< "${ctx}")"

  # Try filterResult for name if object is empty
  if [[ -z "${name}" ]]; then
    local fr
    fr="$(jq -r '.filterResult // empty' <<< "${ctx}")"
    [[ "${fr}" == "null" || -z "${fr}" ]] || name="${fr}"
  fi

  # Inject args array and call handler
  case "${_entry_type}" in
    kubernetes)
      local -a args=("${SHELLOP_K8S_ARGS[@]}")
      "${_handler}" "${event}" "${kind}" "${name}" "${namespace}" "${type}" "${binding}" "${watchEvent}" "${ctx}"
      ;;
    schedule)
      local -a args=("${SHELLOP_CRON_ARGS[@]}")
      "${_handler}" "${event}" "${binding}" "${ctx}"
      ;;
  esac
}

# @description Main entry point — handles --config and dispatches events.
# @arg $@ string Hook arguments (passed by shell-operator)
# @example
#   shell-op::on -k Pod -e Added pod::handle
#   shell-op::run "${@}"
shell-op::run() {
  local startup order=1 config=0 path_ctx="${BINDING_CONTEXT_PATH:-}" path_bindings="${SHELLOP_BINDINGS:-}"
  local -a args=(
    'startup|s:~declared' 'Startup handler function'
    'order|o:~int' 'Startup execution order'
    'config|:+' 'Print shell-operator config'
    'path_ctx|:^~file' 'Path to binding context file'
    'path_bindings|:^~file' 'Path to bindings file'
  )
  :args "Run shell-operator hook" "${@}"

  if (( config )); then
    shell-op::config
    return 0
  fi

  # onStartup: singular script-level call, not dispatched to handlers
  if jq -e '.[0].binding == "onStartup"' "${path_ctx}" &>/dev/null; then
    [[ -z "${startup:-}" ]] || "${startup}"
    return 0
  fi
  
  local count i
  count="$(jq -r 'length' "${path_ctx}")"
  for (( i=0; i < count; i++ )); do
    shell-op::dispatch "${i}"
  done
}

[[ "${0}" != "${BASH_SOURCE[0]}" ]] || shell-op::run "${@}"
