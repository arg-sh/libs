#!/usr/bin/env argsh
# shellcheck shell=bash
# @file shell-op
# @brief Declarative shell-operator hooks with argsh
# @description
#   Wraps flant/shell-operator hook boilerplate into clean argsh functions.
#   Declare bindings, route events to handlers, access context via :args.
#
#   Executable: argsh run shell-op init my-hook
#   Library:    import shell-op

# ── Internal state (minimal) ──────────────────────────

# Each entry: type\thandler\tjson_fragment
declare -ga __SHELLOP_BINDINGS=()
declare -gi __SHELLOP_STARTUP=-1
declare -g  __SHELLOP_STARTUP_HANDLER=""

# ── Pre-defined args arrays for handlers ──────────────

# @description Args array for kubernetes event handlers.
#   Handlers declare `local` for any subset; :args skips the rest.
# @internal
declare -ga __SHELLOP_K8S_ARGS=(
  'event'     "Event (Added/Modified/Deleted/Synchronization/Group/onStartup)"
  'kind'      "Resource kind"
  'name'      "Object metadata.name"
  'namespace' "Object metadata.namespace"
  'type'      "Context type (Event/Synchronization/Group)"
  'binding'   "Binding name"
  'ctx'       "Raw JSON binding context"
)

# @description Args array for cron handlers.
# @internal
declare -ga __SHELLOP_CRON_ARGS=(
  'event'     "Event (Schedule)"
  'binding'   "Binding name"
  'ctx'       "Raw JSON binding context"
)

# ── shell-op::on ───────────────────────────────────────

# @description Register a Kubernetes watch binding.
#   Supports repeated -k and -e flags for multiple kinds/events.
#   Last positional argument is the handler function.
# @example
#   shell-op::on -k v1/Pod -e Added -e Modified -f .metadata.name pod::handle
#   shell-op::on -k Pod -k Service -e Added pod::handle
shell-op::on() {
  local -a _kinds=() _events=()
  local _labels="" _fields="" _jqfilter="" _ns="" _no_sync=0 _group=""
  local _handler=""

  # Parse args manually since we need repeated flags + trailing positional
  while (( $# > 0 )); do
    case "${1}" in
      -k|--kind)       _kinds+=("${2}"); shift 2 ;;
      -e|--event)      _events+=("${2}"); shift 2 ;;
      -l|--labels)     _labels="${2}"; shift 2 ;;
      -f|--filter)     _jqfilter="${2}"; shift 2 ;;
      -n|--namespace)  _ns="${2}"; shift 2 ;;
      -g|--group)      _group="${2}"; shift 2 ;;
      --no-sync)       _no_sync=1; shift ;;
      -h|--help)
        echo "Register a Kubernetes watch binding"
        echo ""
        echo "Usage:"
        echo "  shell-op::on [options] <handler>"
        echo ""
        echo "Options:"
        echo "  -k, --kind       Resource kind, optionally with apiVersion (v1/Pod)"
        echo "  -e, --event      Watch event: Added, Modified, Deleted (repeatable)"
        echo "  -l, --labels     Label selector (key=val,...)"
        echo "  -f, --filter     jq filter expression"
        echo "  -n, --namespace  Namespace to watch"
        echo "  -g, --group      Group key for batching"
        echo "  --no-sync        Skip Synchronization on startup"
        echo "  -h, --help       Show this help"
        return 0
        ;;
      -*)
        echo "shell-op::on: unknown flag: ${1}" >&2
        return 1
        ;;
      *)
        _handler="${1}"; shift
        ;;
    esac
  done

  [[ -n "${_handler}" ]] || { echo "shell-op::on: handler function required" >&2; return 1; }
  (( ${#_kinds[@]} > 0 )) || { echo "shell-op::on: at least one --kind required" >&2; return 1; }

  # Auto-group if multiple kinds
  if (( ${#_kinds[@]} > 1 )) && [[ -z "${_group}" ]]; then
    _group="${_handler}"
  fi

  # Build JSON fragment for each kind
  local _kind_spec _api _kind
  for _kind_spec in "${_kinds[@]}"; do
    # Parse apiVersion/Kind — last segment is kind, prefix is apiVersion
    if [[ "${_kind_spec}" == */* ]]; then
      _api="${_kind_spec%/*}"
      _kind="${_kind_spec##*/}"
    else
      _api=""
      _kind="${_kind_spec}"
    fi
    # Capitalize first letter
    _kind="${_kind^}"

    local _json='{"name":"'"${_handler}"'"'
    _json+=',"kind":"'"${_kind}"'"'

    [[ -z "${_api}" ]]       || _json+=',"apiVersion":"'"${_api}"'"'
    [[ -z "${_jqfilter}" ]]  || _json+=',"jqFilter":"'"${_jqfilter}"'"'
    [[ -z "${_ns}" ]]        || _json+=',"namespace":{"nameSelector":{"matchNames":["'"${_ns}"'"]}}'
    [[ -z "${_group}" ]]     || _json+=',"group":"'"${_group}"'"'

    if (( _no_sync )); then
      _json+=',"executeHookOnSynchronization":false'
    fi

    if (( ${#_events[@]} > 0 )); then
      _json+=',"executeHookOnEvent":['
      local _first=1 _ev
      for _ev in "${_events[@]}"; do
        (( _first )) && _first=0 || _json+=","
        _json+='"'"${_ev}"'"'
      done
      _json+=']'
    fi

    if [[ -n "${_labels}" ]]; then
      _json+=',"labelSelector":{"matchLabels":{'
      local _lfirst=1 _lbl _lk _lv
      IFS=',' read -ra _lbls <<< "${_labels}"
      for _lbl in "${_lbls[@]}"; do
        _lk="${_lbl%%=*}"
        _lv="${_lbl#*=}"
        (( _lfirst )) && _lfirst=0 || _json+=","
        _json+='"'"${_lk}"'":"'"${_lv}"'"'
      done
      _json+='}}'
    fi

    _json+='}'
    __SHELLOP_BINDINGS+=("kubernetes"$'\t'"${_handler}"$'\t'"${_json}")
  done
}

# ── shell-op::cron ─────────────────────────────────────

# @description Register a schedule binding.
# @arg $1 string Crontab expression
# @arg $2 string Handler function
# @example
#   shell-op::cron "*/5 * * * *" cron::handle
shell-op::cron() {
  local _cron="${1}" _handler="${2}"
  [[ -n "${_cron}" ]]    || { echo "shell-op::cron: crontab required" >&2; return 1; }
  [[ -n "${_handler}" ]] || { echo "shell-op::cron: handler function required" >&2; return 1; }

  local _json='{"name":"'"${_handler}"'","crontab":"'"${_cron}"'"}'
  __SHELLOP_BINDINGS+=("schedule"$'\t'"${_handler}"$'\t'"${_json}")
}

# ── shell-op::startup ─────────────────────────────────

# @description Register a startup handler.
# @arg $1 string Handler function (optional, uses onStartup order 1)
# @arg $2 int Order (optional, default: 1)
# @example
#   shell-op::startup pod::handle
#   shell-op::startup pod::handle 10
shell-op::startup() {
  __SHELLOP_STARTUP_HANDLER="${1:-}"
  __SHELLOP_STARTUP="${2:-1}"
}

# ── shell-op::config ──────────────────────────────────

# @description Generate --config JSON from registered bindings.
# @stdout JSON config for shell-operator
# @internal
shell-op::config() {
  local _out='{"configVersion":"v1"'

  if (( __SHELLOP_STARTUP >= 0 )); then
    _out+=',"onStartup":'"${__SHELLOP_STARTUP}"
  fi

  # Collect by type
  local -a _k8s=() _sched=()
  local _entry _type _json
  for _entry in "${__SHELLOP_BINDINGS[@]}"; do
    IFS=$'\t' read -r _type _ _json <<< "${_entry}"
    case "${_type}" in
      kubernetes) _k8s+=("${_json}") ;;
      schedule)   _sched+=("${_json}") ;;
    esac
  done

  if (( ${#_sched[@]} > 0 )); then
    _out+=',"schedule":['
    local _first=1
    for _json in "${_sched[@]}"; do
      (( _first )) && _first=0 || _out+=","
      _out+="${_json}"
    done
    _out+=']'
  fi

  if (( ${#_k8s[@]} > 0 )); then
    _out+=',"kubernetes":['
    local _first=1
    for _json in "${_k8s[@]}"; do
      (( _first )) && _first=0 || _out+=","
      _out+="${_json}"
    done
    _out+=']'
  fi

  _out+='}'
  echo "${_out}"
}

# ── Dispatcher ─────────────────────────────────────────

# @description Dispatch a single binding context entry to the right handler.
# @arg $1 int Context index
# @internal
shell-op::_dispatch() {
  local _i="${1}"
  local _ctx _type _binding _watch_event _event _handler=""

  _ctx="$(jq -c ".[${_i}]" "${BINDING_CONTEXT_PATH}")"
  _type="$(jq -r '.type // empty' <<< "${_ctx}")"
  _binding="$(jq -r '.binding // empty' <<< "${_ctx}")"
  _watch_event="$(jq -r '.watchEvent // empty' <<< "${_ctx}")"

  # Unified event: watchEvent > type > binding
  _event="${_watch_event:-${_type:-${_binding}}}"

  # Find handler by binding name
  local _entry _etype _ehandler
  for _entry in "${__SHELLOP_BINDINGS[@]}"; do
    IFS=$'\t' read -r _etype _ehandler _ <<< "${_entry}"
    if [[ "${_ehandler}" == "${_binding}" ]]; then
      _handler="${_ehandler}"
      break
    fi
  done

  # Startup handler
  if [[ -z "${_handler}" && "${_binding}" == "onStartup" ]]; then
    _handler="${__SHELLOP_STARTUP_HANDLER}"
    _event="onStartup"
  fi

  [[ -n "${_handler}" ]] || return 0

  # Extract object fields
  local _name _namespace _kind
  _name="$(jq -r '.object.metadata.name // empty' <<< "${_ctx}")"
  _namespace="$(jq -r '.object.metadata.namespace // empty' <<< "${_ctx}")"
  _kind="$(jq -r '.object.kind // empty' <<< "${_ctx}")"

  # Also try filterResult for name if object is empty
  if [[ -z "${_name}" ]]; then
    _name="$(jq -r '.filterResult // empty' <<< "${_ctx}")"
    # filterResult might be a string (from jqFilter)
    [[ "${_name}" != "null" ]] || _name=""
  fi

  # Build handler args based on binding type
  local _entry_type=""
  for _entry in "${__SHELLOP_BINDINGS[@]}"; do
    IFS=$'\t' read -r _etype _ehandler _ <<< "${_entry}"
    if [[ "${_ehandler}" == "${_handler}" ]]; then
      _entry_type="${_etype}"
      break
    fi
  done

  # Inject args array and call handler
  case "${_entry_type}" in
    kubernetes)
      local -a args=("${__SHELLOP_K8S_ARGS[@]}")
      "${_handler}" "${_event}" "${_kind}" "${_name}" "${_namespace}" "${_type}" "${_binding}" "${_ctx}"
      ;;
    schedule)
      local -a args=("${__SHELLOP_CRON_ARGS[@]}")
      "${_handler}" "${_event}" "${_binding}" "${_ctx}"
      ;;
    *)
      # Startup or unknown — use k8s args shape
      local -a args=("${__SHELLOP_K8S_ARGS[@]}")
      "${_handler}" "${_event}" "" "" "" "${_type}" "${_binding}" "${_ctx}"
      ;;
  esac
}

# ── shell-op::run ──────────────────────────────────────

# @description Main entry point — handles --config and dispatches events.
#   Use as the last line in your hook script.
# @arg $@ string Hook arguments (passed by shell-operator)
# @example
#   shell-op::on -k Pod -e Added pod::handle
#   shell-op::run "${@}"
shell-op::run() {
  if [[ "${1:-}" == "--config" ]]; then
    shell-op::config
    return 0
  fi

  local _count _i
  _count="$(jq -r 'length' "${BINDING_CONTEXT_PATH}")"

  for (( _i=0; _i < _count; _i++ )); do
    shell-op::_dispatch "${_i}"
  done
}

# ── CLI entry point ────────────────────────────────────

main() {
  local -a usage=(
    'init' 'Scaffold a new shell-operator hook'
  )
  :usage "Declarative shell-operator hooks" "${@}"
  "${usage[@]}"
}

main::init() {
  local name
  local -a args=(
    'name:!' 'Hook name'
  )
  :args "Scaffold a new shell-operator hook" "${@}"

  local _dir="hooks"
  mkdir -p "${_dir}"

  cat > "${_dir}/${name}.sh" << 'HOOK'
#!/usr/bin/env bash
source argsh
import shell-op

pod::handle() {
  local event name namespace ctx
  :args "Handle pod events" "${@}"

  case "${event}" in
    "Synchronization")
      echo "Syncing: ${namespace}/${name}"
      ;;
    *)
      echo "Pod ${namespace}/${name} was ${event}"
      ;;
  esac
}

cron::tick() {
  local event
  :args "Cron tick" "${@}"
  echo "Tick: ${event}"
}

shell-op::on -k v1/Pod -e Added -e Modified -e Deleted pod::handle
shell-op::cron "*/5 * * * *" cron::tick

shell-op::run "${@}"
HOOK

  chmod +x "${_dir}/${name}.sh"
  echo "Created ${_dir}/${name}.sh"
}

# ── Entry point ────────────────────────────────────────

[[ "${0}" != "${BASH_SOURCE[0]}" ]] || main "${@}"
