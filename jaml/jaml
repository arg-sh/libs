#!/usr/bin/env argsh
# shellcheck shell=bash
# @file jaml
# @brief Structured data access for YAML/JSON
# @description
#   Read and write structured data (YAML/JSON) with clean bash syntax.
#   Wraps yq for batch operations — single subprocess for N fields.
#
#   Executable: argsh run jaml get config.yaml .spec.domain
#   Library:    import jaml; jaml::get config.yaml domain=.spec.domain

# ── CLI entry point ─────────────────────────────────────

main() {
  local -a usage=(
    'get'    'Read fields from a YAML/JSON file'
    'set'    'Write fields to a YAML/JSON file'
    'each'   'Iterate array elements'
    'merge'  'Deep merge files'
    'render' 'Render template with data context'
  )
  :usage "Structured data access for YAML/JSON" "${@}"
  "${usage[@]}"
}

# ── jaml::get ───────────────────────────────────────────

# @description Read fields from a YAML/JSON file.
#   var=.path → assigns to variable (nameref)
#   .path     → outputs to stdout
#   Supports any yq expression: .path // "default", .path | length, .path | keys
# @arg $1 string File path (or - for stdin)
# @arg $@ string Field bindings (var=.path or .path)
# @example
#   local domain version
#   jaml::get config.yaml domain=.spec.domain version=.spec.version
#   echo "Version: $(jaml::get config.yaml .spec.version)"
jaml::get() {
  local _file="${1}"; shift
  [[ $# -gt 0 ]] || { echo "jaml::get: no fields specified" >&2; return 1; }

  local -a _var_names=() _expressions=()
  local _arg

  for _arg in "${@}"; do
    if [[ "${_arg}" == *=* ]]; then
      _var_names+=("${_arg%%=*}")
      _expressions+=("${_arg#*=}")
    else
      _var_names+=("")
      _expressions+=("${_arg}")
    fi
  done

  local _yq_expr="" _i _expr
  for (( _i=0; _i < ${#_expressions[@]}; _i++ )); do
    _expr="${_expressions[_i]}"
    [[ -z "${_yq_expr}" ]] || _yq_expr+=", "
    if [[ "${_expr}" == *"//"* ]]; then
      _yq_expr+="(${_expr})"
    else
      _yq_expr+="(${_expr} // \"\")"
    fi
  done

  local -a _values=()
  local _src="${_file}"
  [[ "${_file}" != "-" ]] || _src="/dev/stdin"
  mapfile -t _values < <(yq -r "[${_yq_expr}] | .[]" "${_src}")

  for (( _i=0; _i < ${#_var_names[@]}; _i++ )); do
    if [[ -n "${_var_names[_i]}" ]]; then
      # shellcheck disable=SC2178
      local -n _ref="${_var_names[_i]}"
      _ref="${_values[_i]:-}"
    else
      echo "${_values[_i]:-}"
    fi
  done
}

# CLI wrapper
main::get() {
  local file
  local -a args=(
    'file' 'YAML/JSON file (or - for stdin)'
  )
  :args "Read fields from a file" "${@}"
  shift  # skip file arg, rest are field bindings
  jaml::get "${file}" "${@}"
}

# ── jaml::set ───────────────────────────────────────────

# @description Write fields from variables into a YAML/JSON file.
#   .path=var   → overwrite path with variable value
#   .path[]=var → append to array
#   Detects scalar, indexed array (-a), and associative array (-A).
# @arg $1 string File path
# @arg $@ string Field bindings (.path=var)
jaml::set() {
  local _file="${1}"; shift
  [[ $# -gt 0 ]] || { echo "jaml::set: no fields specified" >&2; return 1; }

  local _yq_expr="" _arg _path _var

  for _arg in "${@}"; do
    _path="${_arg%%=*}"
    _var="${_arg#*=}"

    # shellcheck disable=SC2178
    local -n _ref="${_var}"

    local _append=0
    if [[ "${_path}" == *"[]" ]]; then
      _append=1
      _path="${_path%\[\]}"
    fi

    local _type
    _type="$(declare -p "${_var}" 2>/dev/null)" || _type=""

    if [[ "${_type}" == *"declare -A"* ]]; then
      local _json="{" _k _first=1
      for _k in "${!_ref[@]}"; do
        (( _first )) && _first=0 || _json+=","
        _json+="\"${_k}\":\"${_ref[${_k}]}\""
      done
      _json+="}"
      (( _append )) && _yq_expr+=" | ${_path} += [${_json}]" || _yq_expr+=" | ${_path} = ${_json}"
    elif [[ "${_type}" == *"declare -a"* ]]; then
      local _json="[" _v _first=1
      for _v in "${_ref[@]}"; do
        (( _first )) && _first=0 || _json+=","
        _json+="\"${_v}\""
      done
      _json+="]"
      (( _append )) && _yq_expr+=" | ${_path} += ${_json}" || _yq_expr+=" | ${_path} = ${_json}"
    else
      (( _append )) && _yq_expr+=" | ${_path} += [\"${_ref}\"]" || _yq_expr+=" | ${_path} = \"${_ref}\""
    fi
  done

  yq -i "${_yq_expr:3}" "${_file}"
}

# CLI wrapper
main::set() {
  local file
  local -a args=(
    'file' 'YAML/JSON file'
  )
  :args "Write fields to a file" "${@}"
  shift
  jaml::set "${file}" "${@}"
}

# ── jaml::each ──────────────────────────────────────────

# @description Iterate array elements, binding fields per element.
# @arg $1 string File path (or process substitution)
# @arg $2 string Array path with [] (e.g. '.items[]')
# @arg $@ string Field bindings (var=.field)

declare -g __JAML_EACH_LINES=""
declare -gi __JAML_EACH_IDX=0
declare -g __JAML_EACH_FILE=""
declare -g __JAML_EACH_PATH=""

jaml::each() {
  local _file="${1}" _path="${2}"; shift 2

  if [[ "${_file}:${_path}" != "${__JAML_EACH_FILE}:${__JAML_EACH_PATH}" ]]; then
    local -a _fields=() _var_names=()
    local _arg
    for _arg in "${@}"; do
      if [[ "${_arg}" == *=* ]]; then
        _var_names+=("${_arg%%=*}")
        _fields+=("${_arg#*=}")
      else
        _var_names+=("${_arg}")
        _fields+=(".${_arg}")
      fi
    done

    # Detect if any field uses ^ parent access
    local _has_parent=0
    local _f
    for _f in "${_fields[@]}"; do
      if [[ "${_f}" == "^"* ]]; then
        _has_parent=1
        break
      fi
    done

    local _src="${_file}"
    [[ "${_file}" != "-" ]] || _src="/dev/stdin"

    if (( _has_parent )); then
      # Split the path at [] to find nesting segments
      # e.g. '.items[].spec.containers[]' → ('.items' '.spec.containers')
      local _remaining="${_path}"
      local -a _segments=()
      while [[ "${_remaining}" == *"[]"* ]]; do
        local _seg="${_remaining%%\[\]*}"
        _segments+=("${_seg}")
        _remaining="${_remaining#*\[\]}"
      done

      local _nesting=${#_segments[@]}

      # Build yq expression with as $pN bindings
      # Innermost iteration is the last segment; parents are outer segments
      # $p1 = one level up (parent), $p2 = two levels up, etc.
      local _yq_expr=""
      local _i
      for (( _i=0; _i < _nesting; _i++ )); do
        # Depth from innermost: segment 0 is (nesting-1) levels up
        local _depth_from_inner=$(( _nesting - 1 - _i ))
        if (( _i == 0 )); then
          _yq_expr="${_segments[_i]}[]"
        else
          _yq_expr+="${_segments[_i]}[]"
        fi
        # Bind parent variable for all but the innermost
        if (( _depth_from_inner > 0 )); then
          _yq_expr+=" as \$p${_depth_from_inner} | \$p${_depth_from_inner}"
        fi
      done

      # Build field list, replacing ^.field with $pN.field
      local _yq_fields=""
      for _f in "${_fields[@]}"; do
        [[ -z "${_yq_fields}" ]] || _yq_fields+=", "
        if [[ "${_f}" == "^"* ]]; then
          local _carets="${_f%%[!^]*}"
          local _depth=${#_carets}
          local _field_path="${_f#${_carets}}"
          _yq_fields+="\$p${_depth}${_field_path}"
        else
          _yq_fields+="(${_f} // \"\")"
        fi
      done

      __JAML_EACH_LINES=$(yq -r "${_yq_expr} | [${_yq_fields}] | @tsv" "${_src}")
    else
      local _yq_fields=""
      for _f in "${_fields[@]}"; do
        [[ -z "${_yq_fields}" ]] || _yq_fields+=", "
        _yq_fields+="(${_f} // \"\")"
      done
      __JAML_EACH_LINES=$(yq -r "${_path} | [${_yq_fields}] | @tsv" "${_src}")
    fi

    __JAML_EACH_IDX=0
    __JAML_EACH_FILE="${_file}"
    __JAML_EACH_PATH="${_path}"
  fi

  __JAML_EACH_IDX=$(( __JAML_EACH_IDX + 1 ))
  local _line
  _line=$(sed -n "${__JAML_EACH_IDX}p" <<< "${__JAML_EACH_LINES}") || {
    __JAML_EACH_FILE=""; return 1
  }
  [[ -n "${_line}" ]] || { __JAML_EACH_FILE=""; return 1; }

  local -a _var_names=()
  local _arg
  for _arg in "${@}"; do
    [[ "${_arg}" == *=* ]] && _var_names+=("${_arg%%=*}") || _var_names+=("${_arg}")
  done

  local IFS=$'\t'
  local -a _vals
  read -ra _vals <<< "${_line}"

  local _i
  for (( _i=0; _i < ${#_var_names[@]}; _i++ )); do
    # shellcheck disable=SC2178
    local -n _ref="${_var_names[_i]}"
    _ref="${_vals[_i]:-}"
  done
}

# CLI wrapper — runs the loop and prints TSV
main::each() {
  local file path
  local -a args=(
    'file' 'YAML/JSON file'
    'path' 'Array path (e.g. .items[])'
  )
  :args "Iterate array elements" "${@}"
  shift 2
  # In CLI mode, print TSV output
  local _src="${file}"
  [[ "${file}" != "-" ]] || _src="/dev/stdin"

  if [[ $# -eq 0 ]]; then
    yq -r "${path}" "${_src}"
  else
    local _fields=""
    local _headers=""
    for _arg in "${@}"; do
      local _f="${_arg#*=}"
      local _h="${_arg%%=*}"
      [[ -z "${_fields}" ]] || _fields+=", "
      _fields+="(${_f} // \"\")"
      [[ -z "${_headers}" ]] || _headers+=$'\t'
      _headers+="${_h}"
    done
    echo "${_headers}"
    yq -r "${path} | [${_fields}] | @tsv" "${_src}"
  fi
}

# ── jaml::render ────────────────────────────────────────

# @description Render a template file using values from a data file.
#   Supports {{ .path.to.value }} placeholders (yq expressions).
# @arg $1 string Template file
# @arg $2 string Data file (YAML/JSON)
# @stdout Rendered template
# @example
#   jaml::render deployment.tmpl.yaml config.yaml
jaml::render() {
  local _template="${1}" _data="${2}"
  [[ $# -ge 2 ]] || { echo "jaml::render: usage: jaml::render <template> <data>" >&2; return 1; }

  local _content
  _content="$(cat "${_template}")"

  # Find all {{ .expr }} patterns and replace them
  local _result="${_content}"
  local _match _expr _val
  while [[ "${_result}" =~ \{\{[[:space:]]*([^}]+)[[:space:]]*\}\} ]]; do
    _match="${BASH_REMATCH[0]}"
    _expr="${BASH_REMATCH[1]}"
    _expr="${_expr#"${_expr%%[![:space:]]*}"}"  # trim leading
    _expr="${_expr%"${_expr##*[![:space:]]}"}"  # trim trailing
    _val="$(yq -r "${_expr} // \"\"" "${_data}")"
    _result="${_result//"${_match}"/"${_val}"}"
  done

  echo "${_result}"
}

# CLI wrapper
main::render() {
  local template data
  local -a args=(
    'template' 'Template file'
    'data'     'Data file (YAML/JSON)'
  )
  :args "Render template with data context" "${@}"
  jaml::render "${template}" "${data}"
}

# ── jaml::merge ─────────────────────────────────────────

# @description Deep merge YAML/JSON files. Later files override earlier ones.
# @arg $@ string Files to merge (at least 2)
# @stdout Merged YAML output
jaml::merge() {
  [[ $# -ge 2 ]] || { echo "jaml::merge: need at least 2 files" >&2; return 1; }
  yq eval-all '. as $item ireduce ({}; . * $item)' "${@}"
}

main::merge() {
  :args "Deep merge YAML/JSON files" "${@}"
  jaml::merge "${@}"
}

# ── Entry point ─────────────────────────────────────────

[[ "${0}" != "${BASH_SOURCE[0]}" ]] || main "${@}"
